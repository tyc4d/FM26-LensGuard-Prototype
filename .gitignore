.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# Live scientific outputs can contain model responses and are locally generated.
results/raw_results.jsonl
results/raw_results.csv
results/raw_responses/
results/rate_limits.log
results/*/raw_results.jsonl
results/*/raw_results.csv
results/*/raw_responses/
results/*/rate_limits.log
results/gemini-smoke/
results/local-mock/

# Phase 2 live/demo outputs; controlled mock validation may be regenerated locally.
results_phase2/raw_attempts.jsonl
results_phase2/final_trials.csv
results_phase2/raw_responses/
results_phase2/rate_limits.log
results_phase2/*/raw_attempts.jsonl
results_phase2/*/final_trials.csv
results_phase2/*/raw_responses/
results_phase2/*/rate_limits.log
results_phase2/gemini-*/
results_phase2/demo/
results_phase2/local-mock/

# Hugging Face/model caches and weight files must stay outside the repository.
.cache/huggingface/
.huggingface/
hf_cache/
huggingface_cache/
model_cache/
models--*/
*.safetensors

# Phase 2.5 live local-model evidence. Keep the generated aggregate root report trackable.
results_phase2_5/*/raw_generations.jsonl
results_phase2_5/*/raw_attempts.jsonl
results_phase2_5/*/final_trials.csv
results_phase2_5/*/system_info.json
results_phase2_5/*/raw_responses/
results_phase2_5/*/rate_limits.log
results_phase2_5/*-smoke*/
results_phase2_5/smoke/
results_phase2_5/smoke-*/
# Nested profile roots (for example contract-v2-full/<model>/) contain
# per-trial generations, raw responses, CSVs, plots, and runtime metadata.
# Keep only the profile-level aggregate report eligible for tracking.
results_phase2_5/*/*/

# Phase 3.5 local-model trial streams are reproducible and can contain raw model
# output. Keep audits, analyses, and Markdown reports eligible for tracking.
results_phase3_5/*/*/raw_generations.jsonl
results_phase3_5/*/*/model_call_records.jsonl
results_phase3_5/*/*/final_trials.csv
results_phase3_5/*/*/system_info.json
results_phase3_5/*-smoke*/
results_phase3_5/smoke/
results_phase3_5/smoke-*/

# Physical pilot originals and process-local locks; preserve scientific JSON evidence.
/TestData.zip
/TestData/
/results_physical_pilot/**/.*.running

# Human annotations stay local; scientific data require separate explicit commit approval.
/data/physical_pilot_v1/annotations/
# A clean worktree may share the existing environment through a local symlink.
.venv
